<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.4.1</version>
        <relativePath/>
    </parent>

    <groupId>com.example</groupId>
    <artifactId>rag-spring-demo</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <name>rag-spring-demo</name>
    <description>Mini RAG em Spring Boot: chunking, embeddings, busca por similaridade e geracao via Anthropic API</description>

    <properties>
        <java.version>17</java.version>
        <!-- O Mockito/Byte Buddy gerenciados pelo Spring Boot 3.4.1 ainda nao suportam o
             bytecode do JDK 25; sem isto os mocks de classes concretas falham em runtime
             nessa JVM. -->
        <mockito.version>5.19.0</mockito.version>
        <byte-buddy.version>1.17.5</byte-buddy.version>
    </properties>

    <dependencies>
        <!-- web (traz Jackson/ObjectMapper). O cliente HTTP usa java.net.http nativo. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!-- Actuator: expoe /actuator/health e /actuator/metrics (via Micrometer) para
             observar latencia e saude da aplicacao em runtime. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>

        <!-- Documentacao OpenAPI/Swagger: gera /v3/api-docs e a UI em /swagger-ui.html
             a partir dos controllers e records existentes. -->
        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
            <version>2.8.6</version>
        </dependency>

        <!-- Extracao de texto de arquivos PDF do corpus (classpath:docs/*.pdf). -->
        <dependency>
            <groupId>org.apache.pdfbox</groupId>
            <artifactId>pdfbox</artifactId>
            <version>3.0.3</version>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
