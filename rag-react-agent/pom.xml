<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.5.16</version>
        <relativePath/>
    </parent>

    <groupId>com.example</groupId>
    <artifactId>rag-react-agent</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <name>rag-react-agent</name>
    <description>Integracao RAG + ReAct: contexto inicial recuperado via RAG e injetado na pergunta;
        search_documents fica disponivel como Action, ao lado de calculate/get_weather/convert_currency,
        para o modelo refinar a busca durante o ciclo Thought/Action/Observation.

        Nao depende de common/: o contrato Tool/LlmClient do ReAct e' baseado em texto livre (Action
        Input como String), incompativel com o contrato estruturado (Map/JSON) usado em common/ para
        Function Calling. As classes de tool/llm aqui sao uma porta (Jackson 2 / Spring Boot 3.5) das
        equivalentes em react-agent (Jackson 3 / Spring Boot 4), que nao podem ser importadas diretamente
        por causa da versao incompativel do Jackson.</description>

    <properties>
        <java.version>21</java.version>
        <!-- Fixa Mockito/Byte Buddy em versoes com suporte a bytecode do JDK 25;
             sem isto os mocks de classes concretas falham em runtime nessa JVM. -->
        <mockito.version>5.19.0</mockito.version>
        <byte-buddy.version>1.17.5</byte-buddy.version>
    </properties>

    <dependencies>
        <!-- Embedder/TfidfEmbedder/InMemoryVectorStore/CorpusIndexer/Chunker do RAG, reaproveitados
             como estao (mesmo corpus em classpath:docs/*, empacotado dentro deste jar). -->
        <dependency>
            <groupId>com.example</groupId>
            <artifactId>rag-spring-demo</artifactId>
            <version>0.0.1-SNAPSHOT</version>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
            <version>2.8.9</version>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
