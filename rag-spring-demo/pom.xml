<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.5.16</version>
        <relativePath/>
    </parent>

    <groupId>com.example</groupId>
    <artifactId>rag-spring-demo</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <name>rag-spring-demo</name>
    <description>Mini RAG em Spring Boot: chunking, embeddings, busca por similaridade e geracao via Anthropic API</description>

    <properties>
        <java.version>25</java.version>
        <!-- Fixa Mockito/Byte Buddy em versoes com suporte a bytecode do JDK 25;
             sem isto os mocks de classes concretas falham em runtime nessa JVM. -->
        <mockito.version>5.19.0</mockito.version>
        <byte-buddy.version>1.17.5</byte-buddy.version>
    </properties>

    <dependencies>
        <!-- web (traz Jackson/ObjectMapper). O cliente HTTP usa java.net.http nativo. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!-- Actuator: expoe /actuator/health e /actuator/metrics (via Micrometer) para
             observar latencia e saude da aplicacao em runtime. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>

        <!-- Documentacao OpenAPI/Swagger: gera /v3/api-docs e a UI em /swagger-ui.html
             a partir dos controllers e records existentes. -->
        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
            <version>2.8.6</version>
        </dependency>

        <!-- Extracao de texto de arquivos PDF do corpus (classpath:docs/*.pdf). -->
        <dependency>
            <groupId>org.apache.pdfbox</groupId>
            <artifactId>pdfbox</artifactId>
            <version>3.0.3</version>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <configuration>
                    <!-- rag-function-calling e rag-react-agent dependem deste jar para reusar
                         Embedder/InMemoryVectorStore/CorpusIndexer. Se application.yml fosse
                         empacotado aqui, ele entraria no classpath desses modulos e colidiria
                         com o application.yml de cada um (o Spring resolve "classpath:/application.yml"
                         para um unico arquivo — nao faz merge —, e a ordem de qual jar "ganha" nao e'
                         garantida). Ja foi observado na pratica: anthropic.model e anthropic.base-url
                         deste arquivo vazando para rag-react-agent e quebrando a chamada a Anthropic
                         (URL final duplicada, 404). "mvn spring-boot:run" continua funcionando normalmente
                         (roda direto de target/classes, nao do jar empacotado). -->
                    <excludes>
                        <exclude>application.yml</exclude>
                    </excludes>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <!-- Sem isto, "repackage" substitui o jar normal pelo fat jar executavel,
                         e rag-function-calling/rag-react-agent (que dependem deste modulo para
                         reusar Embedder/InMemoryVectorStore/CorpusIndexer) nao conseguem enxergar
                         as classes, ja que elas ficariam dentro de BOOT-INF/classes. Com o
                         classifier, "mvn install" continua publicando o jar normal como
                         artefato principal (importavel) e o executavel vai como
                         rag-spring-demo-*-exec.jar. -->
                    <classifier>exec</classifier>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
